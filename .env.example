# App
APP_NAME=Enterprise QA Mini
DEBUG=false

# Retriever（当前仅支持 bm25）
RETRIEVER_BACKEND=bm25
RETRIEVAL_TOP_K_DEFAULT=1

# LLM: mock | openai | deepseek | dashscope | local
# mock = 无 API Key，演示检索与界面
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL=          # local 可填 Ollama 地址；其他厂商留空则用默认端点
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
